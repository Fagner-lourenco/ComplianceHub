rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Basic verification
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the current user's profile document
    function getUserProfile() {
      let profile = get(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
      return profile != null && profile.data != null ? profile.data : {};
    }

    // Fast role check via custom claims (set by Cloud Functions on user creation/update).
    // Falls back to getUserProfile() when claims are not yet propagated.
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : getUserProfile().role;
    }

    function getUserTenantId() {
      return request.auth.token.tenantId != null
        ? request.auth.token.tenantId
        : getUserProfile().tenantId;
    }

    // Check if document belongs to the same tenant as the user
    function isSameTenant(tenantId) {
      let userTenantId = getUserTenantId();
      return userTenantId != null && tenantId != null && userTenantId == tenantId;
    }

    // Check if user is internal staff (includes owner for full access)
    function isAnalyst() {
      return getUserRole() in ['analyst', 'supervisor', 'admin', 'owner'];
    }

    // Check if user is admin or owner (full administrative access)
    function isAdmin() {
      return getUserRole() in ['admin', 'owner'];
    }

    // Check if user is a client
    function isClient() {
      return getUserRole() in ['CLIENT', 'client_viewer', 'client_operator', 'client_manager'];
    }

    /* --- COLLECTION RULES --- */

    // 1. User Profiles
    match /userProfiles/{userId} {
      // Users can read their own profile; tenant-wide user directories are operational-only.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAnalyst()
      );
      
      // Profiles are provisioned and managed only by Cloud Functions.
      // This blocks self-promotion of role or tenant context from the client,
      // and prevents analysts from elevating privileges or cross-tenant access.
      allow create, update, delete: if false;
    }

    // 2. Cases
    match /cases/{caseId} {
      // Raw cases are operational/internal documents.
      // Admin/owner see all tenants; other ops users see only their tenant.
      // Client portal must consume the sanitized mirror in /clientCases.
      allow read: if isAuthenticated() && isAnalyst() && (
        isAdmin() || isSameTenant(resource.data.tenantId)
      );

      // All mutations must go through audited Cloud Functions.
      // Direct SDK writes bypass tenant validation, state machines and audit trails.
      allow create, update, delete: if false;

      // 2a. Public Result — sanitized subcollection for client access
      // Published by Cloud Function when analyst concludes case (status → DONE).
      match /publicResult/{docId} {
        allow read: if isAuthenticated() && (
          isAnalyst() ||
          (isClient() && isSameTenant(get(/databases/$(database)/documents/cases/$(caseId)).data.tenantId))
        );
        // Only Cloud Functions write here
        allow create, update, delete: if false;
      }

      // 2b. AI Cache — internal subcollection for inference caching
      match /aiCache/{docId} {
        allow read: if isAuthenticated() && isAnalyst() && (
          isAdmin() || isSameTenant(get(/databases/$(database)/documents/cases/$(caseId)).data.tenantId)
        );
        // Only Cloud Functions write here
        allow create, update, delete: if false;
      }
    }

    // 2c. Client-safe mirror for the customer portal
    match /clientCases/{caseId} {
      allow read: if isAuthenticated() && (
        isAnalyst() ||
        (isClient() && isSameTenant(resource.data.tenantId))
      );
      // Only Cloud Functions write here
      allow create, update, delete: if false;
    }

    // 3. Candidates
    match /candidates/{candidateId} {
      allow read: if isAuthenticated() && isAnalyst() && (
        isAdmin() || isSameTenant(resource.data.tenantId)
      );
      
      // All mutations must go through audited Cloud Functions.
      allow create, update, delete: if false;
    }

    // 4. Audit Logs (ops-only — complete trail)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isAnalyst() && (
        isAdmin() || isSameTenant(resource.data.tenantId)
      );
      
      // Complete audit trail is written by Cloud Functions to keep projections
      // and actor metadata consistent.
      allow create, update, delete: if false;
    }

    // 4b. Tenant Audit Logs (client-safe projection — tenant-scoped)
    match /tenantAuditLogs/{logId} {
      allow read: if isAuthenticated() && (
        isAnalyst() ||
        (isClient() && isSameTenant(resource.data.tenantId))
      );

      // Only Cloud Functions write here (via writeAuditEvent projection)
      allow create, update, delete: if false;
    }

    // 5. Tenant Settings
    match /tenantSettings/{tenantId} {
      allow read: if isAuthenticated() && (
        isAnalyst() ||
        (isClient() && isSameTenant(tenantId))
      );

      // Tenant configuration changes go through updateTenantSettingsByAnalyst.
      allow create, update: if false;
      allow delete: if false;
    }

    // 6. Exports
    match /exports/{exportId} {
      allow read: if isAuthenticated() && (
        isAnalyst() || 
        (isClient() && isSameTenant(resource.data.tenantId))
      );
      
      // Export registration is owned by registerClientExport.
      allow create, update, delete: if false;
    }

    // 7. Public Reports (shareable links)
    // All reads are served via callable Cloud Functions (getPublicReportView, listOpsPublicReports,
    // listClientPublicReports) using Admin SDK — no direct client read needed.
    match /publicReports/{token} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // 8. System Health (circuit breaker state — analyst read, Cloud Functions write)
    match /systemHealth/{providerId} {
      allow read: if isAuthenticated() && isAnalyst();
      allow create, update, delete: if false;
    }

    // 9. Tenant Usage (quota counters — client read own tenant, Cloud Functions write)
    match /tenantUsage/{tenantId} {
      allow read: if isAuthenticated() && (
        isAnalyst() ||
        (isClient() && isSameTenant(tenantId))
      );
      // Only Cloud Functions write here (via transaction in enforceTenantSubmissionLimits)
      allow create, update, delete: if false;
    }

    // 10. Notifications (internal real-time alerts)
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      // Only Cloud Functions create/update notifications
      allow create, update, delete: if false;
    }

    // 11. Case Messages (communication between client and ops)
    match /caseMessages/{messageId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.tenantId != null &&
          isSameTenant(resource.data.tenantId) &&
          (isClient() || isAnalyst())
        )
      );
      allow create, update, delete: if false;
    }

  }
}
